mainmenu "H.264 encode and decode pipeline sample"

menu "H.264 encode and decode pipeline configuration"

config CODEC_CODE_RELOCATE
	bool "Relocate the codec code into RAM"
	select CODE_DATA_RELOCATION
	help
	  Run the encoder, the decoder and the pixel format conversions from
	  RAM instead of the flash. On a microcontroller that executes in
	  place from a serial flash this is where most of their time goes.

if CODEC_CODE_RELOCATE

config CODEC_CODE_RAM_NAME
	string "Codec code RAM location"
	default "RAM"
	help
	  Memory region the codec code is relocated to.

endif # CODEC_CODE_RELOCATE

config CODEC_DATA_RELOCATE
	bool "Relocate the codec memory"
	select CODE_DATA_RELOCATION
	help
	  Place the state and working area of the encoder and the heap of the
	  decoder in named memory regions, on a board whose default RAM is
	  slower than another one it has.

if CODEC_DATA_RELOCATE

config CODEC_ENCODER_RAM_NAME
	string "Encoder memory location"
	default "RAM"
	help
	  Memory region holding the state and working area of the encoder.

config CODEC_DECODER_RAM_NAME
	string "Decoder memory location"
	default "RAM"
	help
	  Memory region holding the heap of the decoder.

endif # CODEC_DATA_RELOCATE

endmenu

source "Kconfig.zephyr"
