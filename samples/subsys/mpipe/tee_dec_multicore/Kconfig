mainmenu "Pipelines on two cores"

menu "Pipeline configuration"

config JPEG_IMAGE_WIDTH
	int "Width of the JPEG images"
	default 320

config JPEG_IMAGE_HEIGHT
	int "Height of the JPEG images"
	default 240

config MJPEG_NUM_FRAMES
	int "Number of frames in the generated test MJPEG stream"
	default 150
	help
	  Number of video frames in the MJPEG stream the application plays.
	  The stream is produced at build time using GStreamer CLI and
	  embedded in the image.

config FILE_OUTPUT_PATH
	string "Output MJPEG file path"
	default "/SD:/rec.mjp"
	help
	  Absolute path of the file the stream is recorded to.

endmenu

config SAMPLE_INCLUDE_REMOTE_DIR
	bool "Include remote core header directory"
	help
	  Include remote build header files. Can be used if primary image
	  needs to be aware of size or base address of secondary image

source "Kconfig.zephyr"
