#include "../pipeline.dtsi"

/* The PXP turns the decoded frames by a quarter turn */
&disp_sink {
	sources = <&rotator>;
};

&{/pipeline} {
	rotator: vid-transform {
		compatible = "zephyr,mpipe-vid-transform";
		sources = <&jpeg_decoder>;
		device = <&pxp>;
		rotation = <90>;
	};
};
