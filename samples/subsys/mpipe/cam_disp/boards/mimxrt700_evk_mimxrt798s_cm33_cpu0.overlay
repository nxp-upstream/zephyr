#include "../pipeline.dtsi"

/* The camera delivers JPEG frames, decoded by the JPEG decoder of the SoC */
&frame_filter {
	pixel-format = "JPEG";
	width = <320>;
	height = <160>;
};

&disp_sink {
	sources = <&vid_convert>;
};

&{/pipeline} {
	jpeg_decoder: vid-transform {
		compatible = "zephyr,mpipe-vid-transform";
		sources = <&frame_filter>;
		device = <&jpegdec>;
	};

	/* From the format the decoder outputs to one the panel takes */
	vid_convert: vid-convert {
		compatible = "zephyr,mpipe-vid-convert";
		sources = <&jpeg_decoder>;
	};
};
