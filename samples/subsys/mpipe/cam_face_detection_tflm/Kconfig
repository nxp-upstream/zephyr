mainmenu "Camera face detection with TFLite Micro"

menu "Camera configuration"

config VIDEO_FRAME_RATE
	int "Frame rate of the video stream"
	default 0
	help
	  Frame rate requested from the camera. If set to 0, the sensor's
	  default frame rate is used.

config VIDEO_CTRL_HFLIP
	int "Mirror the captured frames horizontally"
	range 0 1
	default 0

config VIDEO_CTRL_VFLIP
	int "Mirror the captured frames vertically"
	range 0 1
	default 0

config PROP_NUM_BUFS
	int "Number of frames to capture before stopping"
	default 0
	help
	  If not set or set to 0, the camera streams forever.

endmenu

menu "Inference configuration"

config CAM_FACE_DETECTION_INPUT_MEAN
	int "Pixel level the model input is centered on"
	range 0 255
	default 128
	help
	  Each 8-bit pixel level p is fed to the model as (p - mean) / std,
	  then quantized with the scale and zero point of the input tensor.

config CAM_FACE_DETECTION_INPUT_STD
	int "Pixel level range the model input is divided by"
	range 1 255
	default 127
	help
	  Divisor of the input normalization, see CAM_FACE_DETECTION_INPUT_MEAN.

config CAM_FACE_DETECTION_THRESHOLD
	int "Face detection threshold in percent"
	range 1 100
	default 60
	help
	  Boxes whose face probability is below this value are discarded. The
	  led0 LED is lit while a face is reported.

config CAM_FACE_DETECTION_NMS_THRESHOLD
	int "Overlap threshold of the non-maximum suppression in percent"
	range 1 100
	default 50
	help
	  A box is discarded when its intersection over union with a
	  higher-scoring box reaches this value.

config CAM_FACE_DETECTION_MAX_BOXES
	int "Maximum faces reported per frame"
	range 1 32
	default 16
	help
	  Upper bound on the boxes kept from one inference.

config CAM_FACE_DETECTION_PRINT_PERIOD_MS
	int "Result reporting period in milliseconds"
	default 1000
	help
	  The latest result is printed, and the display overlay and the LED
	  are updated, once per period. Inferences finishing in between
	  replace the pending result rather than queueing behind it.

config CAM_FACE_DETECTION_NPU_REGION_NAME
	string "Memory region for the model and its tensor arena"
	default "SRAM1"
	help
	  Name of a zephyr,memory-region devicetree node the Neutron NPU can
	  reach. The NPU reads the model's microcode and weights in place and
	  reads and writes the tensors itself, so the model is copied there
	  from flash at start-up and the tensor arena is allocated there.

config CAM_FACE_DETECTION_ARENA_SIZE
	int "TFLite Micro tensor arena size in bytes"
	default 1277952
	help
	  Holds the input, output and intermediate tensors and the NPU scratch
	  buffer. The Neutron converter reports 1178528 bytes of tensors for
	  ultraface_slim; the sample logs the bytes actually used at start-up.

config INFERENCE_DROP_FRAMES
	bool "Drop frames captured while the model is busy"
	default y
	help
	  With a live camera the frames arriving during an inference are
	  dropped, so the result always describes a recent frame. Disable this
	  to score every frame instead, at the cost of back-pressure on the
	  camera.

config INFERENCE_STACK_SIZE
	int "Inference thread stack size"
	default 4096

config INFERENCE_PRIORITY
	int "Inference thread priority"
	default 5

endmenu

menu "Display configuration"

config CAM_FACE_DETECTION_DISPLAY_QUEUE_SIZE
	int "Buffers the display branch may hold"
	range 1 MPIPE_BASE_QUEUE_MAX_SIZE
	default 1
	help
	  Buffers queued for the display while the previous one is rendered.
	  They cannot be reused meanwhile, so keep this well below the size of
	  the pool they come from.

endmenu

source "Kconfig.zephyr"
