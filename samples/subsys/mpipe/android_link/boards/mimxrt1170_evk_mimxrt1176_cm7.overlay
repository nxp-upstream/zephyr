/* The codec takes its master clock from the SAI */
&sai1 {
	mclk-output;
};

/* The on-board digital microphone, one channel: PDM data line 0, left */
dmic_dev: &micfil {
	channel0: micfil-channel@0 {
		status = "okay";
	};
};
