/*
 * native_sim uses the SDL display and the SDL pointer input already declared
 * by the board devicetree (chosen zephyr,display = &sdl_dc and
 * zephyr,touch = &input_sdl_touch). The panel geometry is pinned here so that
 * it matches the resolution the client is expected to stream: the sender must
 * scale to 720x1280 to match this panel. The audio goes to the emulated I2S
 * through the dummy codec.
 */

/ {
	aliases {
		i2s-codec-tx = &i2s_tx0;
	};
};

&sdl_dc {
	compatible = "zephyr,sdl-dc";
	width = <720>;
	height = <1280>;
};

&i2s_tx0 {
	status = "okay";
};

&audio_codec {
	status = "okay";
};
