/*
 * native_sim uses the SDL display and the SDL pointer input already declared
 * by the board devicetree (chosen zephyr,display = &sdl_dc and
 * zephyr,touch = &input_sdl_touch). The window takes the size of a phone's
 * screen in portrait; the frame size the sample expects follows it
 * (CONFIG_ANDROID_LINK_FRAME_WIDTH/HEIGHT) and the sender must stream that
 * size. The audio goes to the emulated I2S through the dummy codec, and the
 * microphone is the emulated DMIC.
 */

/ {
	aliases {
		i2s-codec-tx = &i2s_tx0;
	};
};

&sdl_dc {
	compatible = "zephyr,sdl-dc";
	width = <720>;
	height = <1280>;
};

dmic_dev: &dmic0 {
	status = "okay";
};

&i2s_tx0 {
	status = "okay";
};

&audio_codec {
	status = "okay";
};
