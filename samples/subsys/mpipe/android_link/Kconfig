source "Kconfig.zephyr"

config NET_STACK_CODE_RELOCATE
	bool "Relocate networking code into RAM"
	select CODE_DATA_RELOCATION
	help
	  Relocate networking code into RAM. Can improve performance on
	  platforms with fast code RAM.

if NET_STACK_CODE_RELOCATE

config NET_STACK_CODE_RAM_NAME
	string "Networking code RAM location"
	default "RAM"
	help
	  Region to relocate networking code to

endif # NET_STACK_CODE_RELOCATE

config ANDROID_LINK_AUDIO
	bool "Play the phone's audio"
	default y
	depends on MPIPE_AUD
	help
	  Accept the phone's audio connection and play the raw PCM it carries
	  through a second pipeline ending in the I2S codec sink. The phone
	  must be launched with audio enabled and the raw codec.

config ANDROID_LINK_MIC
	bool "Send the board's microphone to the phone"
	default y
	depends on MPIPE_AUD && AUDIO_DMIC
	help
	  Accept a fourth connection from the phone, after the control one,
	  and send it the board's microphone as raw PCM, 16 kHz, 32-bit, two
	  channels, through a third pipeline from the DMIC source to a socket
	  sink. What the phone does with the stream, play it on its speaker,
	  feed it to the applications recording from its microphone, or drop
	  it, is set by a control message. The phone must be launched with the
	  microphone channel enabled.

config ANDROID_LINK_PORT
	int "TCP port the board listens on"
	range 1 65535
	default 5000
	help
	  Port of the listening socket the phone's server connects to for the
	  video, audio, control and microphone streams (REMOTE_PORT in its
	  launch script).

if WIFI

config ANDROID_LINK_WIFI_SSID
	string "Name of the board's Wi-Fi network"
	default "zephyr-link"
	help
	  SSID of the soft-AP the board starts. The phone's server joins it
	  by itself when launched with the same name (WIFI_SSID).

config ANDROID_LINK_WIFI_PSK
	string "Passphrase of the board's Wi-Fi network"
	default "zephyrdemo"
	help
	  WPA2 passphrase of the soft-AP, at least 8 characters; empty for an
	  open network. The phone's server needs the same value (WIFI_PSK).

endif # WIFI

choice
	prompt "Control Event protocol"
	default CONTROL_EVENT_TCP

config CONTROL_EVENT_UDP
	bool "Control UDP protocol"
	help
	  Control events are reported using the UDP protocol.

config CONTROL_EVENT_TCP
	bool "Control TCP protocol"
	help
	  Touch events are reported using the TCP protocol.

endchoice
