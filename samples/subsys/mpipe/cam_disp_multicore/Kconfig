mainmenu "Camera on one core, display on the other"

menu "Pipeline configuration"

config VIDEO_FRAME_WIDTH
	int "Width of the video frame"
	default 320
	help
	  Width of the frames asked of the source on the other core.

config VIDEO_FRAME_HEIGHT
	int "Height of the video frame"
	default 240
	help
	  Height of the frames asked of the source on the other core.

endmenu

config SAMPLE_INCLUDE_REMOTE_DIR
	bool "Include remote core header directory"
	help
	  Include remote build header files. Can be used if primary image
	  needs to be aware of size or base address of secondary image

source "Kconfig.zephyr"
