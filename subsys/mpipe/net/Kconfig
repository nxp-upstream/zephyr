config MPIPE_NET
	bool "Network plugin support"
	depends on NETWORKING && NET_TCP && NET_SOCKETS
	select NET_IPV4_MAPPING_TO_IPV6 if NET_NATIVE_IPV6
	help
	  Elements that move a stream over a socket: a socket source and sink
	  reading and writing a connected socket the application hands them,
	  and a TCP server source and sink built on them that listen on a port
	  of their own and take one client.
	  With IPv6 enabled a single socket serves IPv4 clients too, through
	  IPv4-mapped addresses.

if MPIPE_NET

config MPIPE_NET_SINK_PORT
	int "Default port the TCP sink listens on"
	range 1 65535
	default 5000
	help
	  Used unless the application sets MPIPE_PROP_TCP_SERVER_SINK_PORT.

config MPIPE_NET_SRC_PORT
	int "Default port the TCP source listens on"
	range 1 65535
	default 5001
	help
	  Used unless the application sets MPIPE_PROP_TCP_SERVER_SRC_PORT.

config MPIPE_NET_LISTEN_BACKLOG
	int "Pending connections a listening socket keeps"
	range 1 16
	default 2
	help
	  Connections completed by the TCP stack but not yet accepted. An
	  element takes one client, but an application may accept further
	  connections on the same listening socket, and a peer that opens them
	  back to back has its second SYN dropped while the backlog is full,
	  until it retransmits.

config MPIPE_NET_SRC_BUF_SIZE
	int "Size of a socket source receive chunk in bytes"
	range 1024 16777216
	default 65536
	help
	  The stream is received into chunks of this size, and each read is
	  pushed downstream as a view of the chunk it landed in. A frame that
	  fits in a chunk reaches the consumer without being copied, so make
	  the chunk a few times larger than a frame.

config MPIPE_NET_SRC_NUM_BUFS
	int "Number of chunks in the socket source pool"
	range 2 255
	default 4
	help
	  A chunk returns to the pool once every view of it has been released,
	  so the frames downstream still holds pin their chunks. Two is the
	  minimum for the source to fill one while the other is consumed.

config MPIPE_NET_SRC_MIN_READ
	int "Room left in a chunk below which the next one is started"
	range 64 65536
	default 4096
	help
	  A read into the tail of a chunk is pushed as a view like any other;
	  this bounds how small such a tail read may get.

endif # MPIPE_NET
