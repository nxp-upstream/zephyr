menuconfig MPIPE
	bool "Multimedia Pipeline framework"
	select NET_BUF
	help
	  Enable the Multimedia Pipeline framework.

if MPIPE

module = MPIPE
module-str = mpipe
source "subsys/logging/Kconfig.template.log_config"

# ---- Framework options ----

config MPIPE_STRUCTURE_MAX_FIELDS
	int "Maximum fields one caps structure can hold"
	range 1 255
	default 5
	help
	  Number of capability fields a single caps structure can hold at once.
	  Size this for the largest union of fields that can meet in one intersection,
	  not for the number of fields an element sets. An intersection carries through
	  the fields that only one side constrains, so its result can hold more fields
	  than either input. Negotiation reports -ENOSPC when a structure runs out of slots.

config MPIPE_THREADS_NUM
	int "Number of mpipe_thread wrappers used by the whole application"
	range 0 255
	default 1

config MPIPE_THREAD_STACK_SIZE
	int "Stack size of a thread"
	default 1024

config MPIPE_THREAD_DEFAULT_PRIORITY
	int "Priority of a thread"
	default 5

config MPIPE_WORKQUEUE
	bool "Element-level work offload (P4WQ)"
	select SCHED_DEADLINE
	help
	  Enable element-level work offloading via a shared P4WQ
	  (Pooled Parallel Preemptible Priority-based Work Queue)
	  thread pool. Elements can submit finite work items (e.g.,
	  decode, inference) to be processed on pool threads with
	  configurable priority.

config MPIPE_WORKQUEUE_THREADS_NUM
	int "Number of threads in mpipe workqueue pool"
	default 1
	depends on MPIPE_WORKQUEUE
	help
	  Number of threads in the shared P4WQ pool used for
	  element-level work offload.

config MPIPE_WORKQUEUE_STACK_SIZE
	int "Stack size for mpipe workqueue pool threads"
	default 4096
	depends on MPIPE_WORKQUEUE
	help
	  Stack size in bytes for each thread in the mpipe workqueue pool.

config MPIPE_NET_BUF_POOL_COUNT
	int "Number of buffers in the mpipe shared net_buf pool"
	default 1
	help
	  Number of buffers needed in the shared mpipe net_buf pool across pipelines.
	  This is sum of the maximum number of in-flight net_buf buffers of each
	  pipeline at any given time

config MPIPE_DUMP
	bool "Dump pipeline topology and information"
	help
	  If enabled, pipeline topology and other information like state, caps, element's
	  properties can be dumped for debugging purpose.

	  The dump is written in dot format to the console which can be gotten and rendered
	  by Graphviz on the host machine.

config MPIPE_BIN_MAX_CHILDREN
	int "Maximum number of elements in a bin/pipeline"
	range 2 64
	default 10
	help
	  Maximum number of child elements that can be added to a single
	  bin or pipeline. This is used to size the bin's internal arrays for
	  topological sort during state changes.

config MPIPE_FAKE_SRC
	bool "Fake source element"
	help
	  Emulated source element for pipeline testing.

config MPIPE_FAKE_SRC_BUF_SZ
	int "Buffer size of the fake source element (in bytes)"
	range 1 1024
	default 1
	depends on MPIPE_FAKE_SRC

config MPIPE_BUS_QUEUE_DEPTH
	int "Message bus queue depth"
	default 2
	help
	  Bus queue depth

config MPIPE_RPC
	bool "RPC support"

# ---- Plugins and utilities ----
# Each plugin/utility directory ships its own Kconfig, guarded by its own
# CONFIG_MPIPE_* option. Adding a new plugin needs no change to this file.
osource "subsys/mpipe/*/Kconfig"

endif # MPIPE
