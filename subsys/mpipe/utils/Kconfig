config MPIPE_DT
	bool "Pipelines described in the devicetree"
	default y
	depends on DT_HAS_ZEPHYR_MPIPE_PIPELINE_ENABLED
	imply MPIPE_PLAYER
	help
	  Build at boot the pipelines the devicetree describes with
	  zephyr,mpipe-pipeline nodes, and play those with the autostart
	  property, with no application code. The option of an element type
	  is enabled by default when the devicetree has a node of that type.

config MPIPE_DT_INIT_PRIORITY
	int "Initialization priority of the devicetree pipelines"
	default 95
	depends on MPIPE_DT
	help
	  Priority, in the APPLICATION level, at which the pipelines of the
	  devicetree are built and those with the autostart property played.

config MPIPE_PLAYER
	bool "Multimedia Pipeline player helper"
	depends on MPIPE
	imply SHELL
	imply SERIAL
	imply UART_CONSOLE
	help
	  Enable the mpipe_player control layer: a reusable, media-player-like
	  helper that owns the run-time lifecycle of a pipeline (play, pause,
	  stop, replay, quit). When SHELL is enabled it also registers
	  interactive shell commands ("player play|pause|stop|replay|quit|status"
	  and the single-letter shortcuts p/s/r/q).

if MPIPE_PLAYER

config MPIPE_PLAYER_NUM
	int "Number of players the application can have at once"
	range 1 255
	default $(dt_compat_enabled_num,$(DT_COMPAT_ZEPHYR_MPIPE_PIPELINE)) if MPIPE_DT
	default 1
	help
	  Each player owns a worker thread, so this sizes a pool of worker
	  stacks. A pipeline that streams needs an mpipe thread of its own as
	  well: MPIPE_THREADS_NUM must cover every pipeline playing at once.

config MPIPE_PLAYER_WORKER_STACK_SIZE
	int "Player worker thread stack size"
	default 6144
	help
	  Stack size (in bytes) for the player worker thread that serializes
	  pipeline state changes.

	  Capability negotiation runs on this thread and recurses from the source
	  down to the sinks. Each element keeps a few capabilities live while it
	  negotiates, roughly 800 bytes, so budget that much per element. The
	  default suits chains of up to about seven elements; raise it for longer
	  pipelines.

config MPIPE_PLAYER_WORKER_PRIORITY
	int "Player worker thread priority"
	default 5
	help
	  Scheduling priority for the player worker thread.

config MPIPE_PLAYER_CMD_QUEUE_DEPTH
	int "Player command queue depth"
	default 8
	help
	  Number of pending commands the player can buffer. Posting never
	  blocks, so a command asked for once the queue is full is dropped
	  and reported.

config MPIPE_PLAYER_DUMP_ON_STATE_CHANGE
	bool "Dump the pipeline on every state change and every error"
	depends on MPIPE_DUMP
	help
	  Print the pipeline after each state the player drives it to, and
	  whenever an element reports an error.

	  The dump is taken once the transition has finished, never between
	  two of them, so it delays nothing: a failure stops the pipeline
	  where it broke and the graph is still that failure's graph.

	  It goes to the console rather than the shell, since no shell
	  instance exists at that point. Extract a graph from a capture with:

	    sed -n '/^digraph/,/^}/p' log > pipe.dot

endif # MPIPE_PLAYER

config MPIPE_PIPELINE_SERVER
	bool "Pipeline server (serve a pipeline to another core)"
	depends on MPIPE_BASE_APP_SRC && MPIPE_BASE_APP_SINK
	help
	  Enable the pipeline server: the counterpart, on the core that does
	  the work, of a client element in the pipeline of another core. The
	  application builds an ordinary pipeline between an application
	  source and an application sink, and the server answers the client's
	  calls with it: capabilities, negotiation, one buffer at a time,
	  state changes and end of stream.

	  The server knows no media type and no transport. A plugin provides
	  the adapter for its media type, and the transport binding with it.

config MPIPE_DUMP
	bool "Pipeline topology dump"
	select MPIPE_ELEMENT_NAME
	help
	  Render a bin as a Graphviz graph for debugging: every element with
	  its state and pads, the peer of each pad and the capability
	  negotiated on it. The DOT text is written through a callback, to the
	  console by default.

config MPIPE_DUMP_MAX_ELEMENTS
	int "Maximum number of elements a dump can index"
	depends on MPIPE_DUMP
	range 2 256
	default 32
	help
	  A dump flattens nested bins, so it can hold more elements than one
	  bin's MPIPE_BIN_MAX_CHILDREN. An element past this limit is left out
	  of the graph and the dump is marked truncated.
