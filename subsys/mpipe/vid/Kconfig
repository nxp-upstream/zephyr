config MPIPE_VID
	bool "Video plugin support"
	select VIDEO
	help
	  Elements backed by Zephyr video devices: capture from a camera, and
	  memory-to-memory transforms performed by hardware such as a scaler,
	  rotator or decoder.

	  This is where zero-copy matters most, so the pools here hand out the
	  driver's own buffers rather than copies, and a frame captured by a
	  camera reaches the display without being moved.

if MPIPE_VID

config MPIPE_VID_CONVERT
	bool "Software-based pixel format converter"
	help
	  A transform that converts a frame from one pixel format to another on
	  the CPU.

	  It exists as the fallback for a conversion no hardware on the board can
	  do, which is common between a decoder's output format and what a panel
	  accepts. It converts pixel formats only: it does not scale, crop or
	  rotate. Expect it to cost real CPU time per frame.

config MPIPE_VID_H264_DECODER
	bool "Software H.264 decoder element"
	depends on ZEPHYR_H264SWDEC_MODULE
	select H264SWDEC
	help
	  Transform element that decodes an H.264 byte stream to planar
	  YUV 4:2:0 frames with the h264swdec module, for Baseline and
	  Constrained Baseline streams. The decoder takes its picture buffers
	  from the heap of the module (H264SWDEC_HEAP_SIZE).

if MPIPE_VID_H264_DECODER

config MPIPE_VID_H264_DECODER_POOL_NUM
	int "Number of buffers in the H.264 decoder's output pool"
	range 1 255
	default 2
	help
	  Number of buffers in the decoder's internal output pool, used when
	  downstream proposes no pool of its own. A picture decoded while every
	  buffer is held downstream is not shown.

config MPIPE_VID_H264_DECODER_MAX_OUT_FRAME_SIZE
	int "Maximum decoded frame size in bytes"
	default 115200
	help
	  Size of the buffers in the decoder's internal output pool: width x
	  height x 3 / 2 of the largest picture. The default holds 320x240.

endif # MPIPE_VID_H264_DECODER

config MPIPE_VID_H264_ENCODER
	bool "Software H.264 encoder element"
	depends on ZEPHYR_MINIH264_MODULE
	select MINIH264
	help
	  Transform element that encodes planar YUV 4:2:0 frames to a
	  Constrained Baseline H.264 byte stream with the minih264 module.

if MPIPE_VID_H264_ENCODER

config MPIPE_VID_H264_ENCODER_POOL_NUM
	int "Number of buffers in the H.264 encoder's output pool"
	range 1 255
	default 2
	help
	  Number of buffers in the encoder's internal output pool, used when
	  downstream proposes no pool of its own. A frame that arrives while
	  every buffer is held downstream is not encoded.

config MPIPE_VID_H264_ENCODER_MAX_OUT_FRAME_SIZE
	int "Maximum encoded frame size in bytes"
	default 32768
	help
	  Size of the buffers in the encoder's internal output pool. A frame
	  that encodes to more is dropped and the next one is a key frame.

config MPIPE_VID_H264_ENCODER_PERSIST_SIZE
	int "Encoder state size in bytes"
	default 294912
	help
	  Memory reserved for the encoder state, which holds the reference
	  frame. The size depends on the frame size; the element reports the
	  size it needs when the reserved one is too small. A 320x240 frame
	  needs 288368 bytes.

config MPIPE_VID_H264_ENCODER_SCRATCH_SIZE
	int "Encoder working area size in bytes"
	default 196608
	help
	  Memory reserved for the encoder working area, which holds the
	  encoded frame. The size depends on the frame size; the element
	  reports the size it needs when the reserved one is too small. A
	  320x240 frame needs 182607 bytes.

endif # MPIPE_VID_H264_ENCODER

config MPIPE_VID_OVERLAY
	bool "Video overlay element"
	help
	  A transform handing every buffer to an application draw callback,
	  the pipeline equivalent of drawing on a canvas, with drawing helpers
	  for rectangles, fills and text. In frame mode it draws into the video
	  frame, in place when nobody else holds it and into a copy otherwise,
	  as behind a tee. In plane mode it draws into a transparent BGRA32
	  frame of its own for a display sink on a display plane, and the
	  display controller blends the drawing over the video. Text needs the
	  character framebuffer's built-in fonts
	  (CHARACTER_FRAMEBUFFER_USE_DEFAULT_FONTS).

	  It is the software fallback and demonstration tier: the target for
	  compositing is an aggregator-based compositor and, where the display
	  controller has them, hardware layers.

config MPIPE_VID_PIPELINE_SERVER
	bool "Video adapter of the pipeline server"
	depends on MPIPE_PIPELINE_SERVER
	help
	  Serve a video pipeline to a video client element on another core:
	  the functions answering the calls of the video transform and sink
	  clients with a pipeline server, translating between the formats of
	  the video API the clients speak and the capabilities the served
	  pipeline negotiates with.

endif # MPIPE_VID
