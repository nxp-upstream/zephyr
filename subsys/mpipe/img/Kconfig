config MPIPE_IMG
	bool "Image codec plugin support"
	help
	  Elements that turn a coded image stream into frames and decode them: a
	  JPEG parser that finds frame boundaries in undifferentiated bytes, and
	  an optional software JPEG decoder that produces raw pixels.

	  The two are separate because the split is real. The parser is what
	  first knows the format, and it can be followed either by the software
	  decoder here or by a hardware decoder from the video plugin, without
	  either side knowing which.

if MPIPE_IMG

config MPIPE_IMG_JPEG_PARSER_MAX_FRAME_SIZE
	int "Maximum JPEG frame size in bytes"
	default 0
	help
	  Longest frame the parser produces, and the size of the buffers in its
	  own pool. A frame that lies inside one input chunk is emitted as a view
	  of the chunk; a frame split across two chunks is copied into one of
	  these buffers. 0 reserves no pool, which only works when the element
	  downstream offers a pool of its own, in which case every frame is
	  copied into that pool.

config MPIPE_IMG_JPEG_PARSER_POOL_NUM
	int "Copy pool buffer count"
	range 1 255
	default 2
	help
	  Number of buffers in the parser's own pool. One frame is being copied
	  while the previous one is consumed downstream, so two is usually
	  enough; raise it when the elements downstream hold frames.

config MPIPE_IMG_JPEG_DECODER
	bool "Software JPEG decoder element"
	depends on ZEPHYR_JPEGDEC_MODULE
	select JPEGDEC
	help
	  Transform element that decodes JPEG frames to raw pixels with the
	  jpegdec module. Boards with a JPEG decoder block use the video
	  plugin's transform element instead.

if MPIPE_IMG_JPEG_DECODER

config MPIPE_IMG_JPEG_DECODER_POOL_NUM
	int "Number of buffers in the jpeg decoder's output pool"
	range 1 255
	default 1
	help
	  Number of buffers in the decoder's internal output pool, used when
	  downstream proposes no pool of its own.

	  One is enough where the element downstream consumes each frame before
	  the next arrives, which is the case for a display sink. Raise it when
	  downstream holds frames past the chain call: a frame decoded while
	  every buffer is held is dropped, not waited for.

config MPIPE_IMG_JPEG_DECODER_MAX_OUT_FRAME_SIZE
	int "Maximum decoded output frame size in bytes"
	default 153600
	help
	  Maximum decoded output frame size in bytes for the SW JPEG decoder internal pool.
	  Default value is set for 320x240 RGB565 format.

endif # MPIPE_IMG_JPEG_DECODER

endif # MPIPE_IMG
