config MP_PLAYER
	bool "MultimediaPipe player helper"
	depends on MP
	select POLL
	imply SHELL
	imply SERIAL
	imply UART_CONSOLE
	help
	  Enable the mp_player control layer: a reusable, media-player-like
	  helper that owns the run-time lifecycle of a pipeline (play, pause,
	  stop, replay, quit). When SHELL is enabled it also registers
	  interactive shell commands ("player play|pause|stop|replay|status"
	  and the single-letter shortcuts p/s/r/q).

if MP_PLAYER

config MP_PLAYER_WORKER_STACK_SIZE
	int "Player worker thread stack size"
	default 6144
	help
	  Stack size (in bytes) for the player worker thread that serializes
	  pipeline state changes.

	  Capability negotiation runs on this thread and recurses from the source
	  down to the sinks. Each element keeps a few capabilities live while it
	  negotiates, roughly 800 bytes, so budget that much per element. The
	  default suits chains of up to about seven elements; raise it for longer
	  pipelines.

config MP_PLAYER_WORKER_PRIORITY
	int "Player worker thread priority"
	default 5
	help
	  Scheduling priority for the player worker thread.

config MP_PLAYER_CMD_QUEUE_DEPTH
	int "Player command queue depth"
	default 8
	help
	  Number of pending commands the player can buffer before a caller
	  blocks while enqueueing a new command.

config MP_PLAYER_DUMP_ON_STATE_CHANGE
	bool "Dump the pipeline on every state change and every error"
	depends on MP_DUMP
	help
	  Print the pipeline after each state the player drives it to, and
	  whenever an element reports an error.

	  The dump is taken once the transition has finished, never between
	  two of them, so it delays nothing: a failure stops the pipeline
	  where it broke and the graph is still that failure's graph.

	  It goes to the console rather than the shell, since no shell
	  instance exists at that point. Extract a graph from a capture with:

	    sed -n '/^digraph/,/^}/p' log > pipe.dot

endif # MP_PLAYER

config MP_DUMP_MAX_ELEMENTS
	int "Maximum number of elements a dump can index"
	depends on MP_DUMP
	range 2 256
	default 32
	help
	  A dump flattens nested bins, so it can hold more elements than one
	  bin's MP_BIN_MAX_CHILDREN. An element past this limit is left out
	  of the graph and the dump is marked truncated.
