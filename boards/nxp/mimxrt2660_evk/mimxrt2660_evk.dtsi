#include "mimxrt2660_evk-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	aliases {
		led0 = &user_led;
		sw0 = &user_button;
	};

	leds {
		compatible = "gpio-leds";

		user_led: led_0 {
			/*
			 * USER_LED (D16), ball PIO2_26 -> HSP gpio0 pin 26.
			 * Driven through series R329 and transistor Q6, so it
			 * is active low.
			 */
			gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
			label = "User LED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			/*
			 * WAKE_SS_BTN, ball PIO1_0 -> gpio6 pin 0. SW6 shorts the
			 * net to ground, so it is active low. The 3V3 pull-up R49
			 * is DNP on this revision, which makes the internal pull-up
			 * required rather than optional.
			 */
			label = "User SW (WAKE)";
			gpios = <&gpio6 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&lpuart0 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart0>;
	pinctrl-names = "default";
};

&lpi2c0 {
	pinctrl-0 = <&pinmux_lpi2c0>;
	pinctrl-names = "default";

	/* PCAL6524 (0x22): LCM_RGB_5INCH panel power-enable on pin 16. */
	pcal6524: gpio@22 {
		compatible = "nxp,pcal6524";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <24>;
	};

	/* PCA9555 (0x21): LCM_RGB_5INCH panel backlight-enable on pin 9. */
	pca9555: gpio@21 {
		compatible = "nxp,pca9555";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};
};

&dcif {
	pinctrl-0 = <&pinmux_dcif>;
	pinctrl-names = "default";
};
