config SOC_FAMILY_MCXC
	bool

config SOC_FAMILY
	default "mcxc" if SOC_FAMILY_MCXC

config SOC_MCXC141
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC142
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC242
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC444
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC454
	bool
	select SOC_FAMILY_MCXC

config SOC
	default "mcxc141" if SOC_MCXC141
	default "mcxc142" if SOC_MCXC142
	default "mcxc242" if SOC_MCXC242
	default "mcxc444" if SOC_MCXC444
	default "mcxc454" if SOC_MCXC454

config SOC_PART_NUMBER_MCXC141VLH
	bool

config SOC_PART_NUMBER_MCXC141VFM
	bool

config SOC_PART_NUMBER_MCXC142VFM
	bool

config SOC_PART_NUMBER_MCXC242VLH
	bool

config SOC_PART_NUMBER_MCXC242VFM
	bool

config SOC_PART_NUMBER_MCXC444VLH
	bool

config SOC_PART_NUMBER_MCXC444VMP
	bool

config SOC_PART_NUMBER_MCXC454VFM
	bool

config SOC_PART_NUMBER_MCXC454VFT
	bool

config SOC_PART_NUMBER_MCXC454VLF
	bool

config SOC_PART_NUMBER_MCXC454VLH
	bool

config SOC_PART_NUMBER_MCXC454VLK
	bool

config SOC_PART_NUMBER_MCXC454VMP
	bool

config SOC_PART_NUMBER
	default "MCXC141VLH" if SOC_PART_NUMBER_MCXC141VLH
	default "MCXC141VFM" if SOC_PART_NUMBER_MCXC141VFM
	default "MCXC142VFM" if SOC_PART_NUMBER_MCXC142VFM
	default "MCXC242VLH" if SOC_PART_NUMBER_MCXC242VLH
	default "MCXC242VFM" if SOC_PART_NUMBER_MCXC242VFM
	default "MCXC444VLH" if SOC_PART_NUMBER_MCXC444VLH
	default "MCXC444VMP" if SOC_PART_NUMBER_MCXC444VMP
	default "MCXC454VFM" if SOC_PART_NUMBER_MCXC454VFM
	default "MCXC454VFT" if SOC_PART_NUMBER_MCXC454VFT
	default "MCXC454VLF" if SOC_PART_NUMBER_MCXC454VLF
	default "MCXC454VLH" if SOC_PART_NUMBER_MCXC454VLH
	default "MCXC454VLK" if SOC_PART_NUMBER_MCXC454VLK
	default "MCXC454VMP" if SOC_PART_NUMBER_MCXC454VMP
