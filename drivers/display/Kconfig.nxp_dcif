menuconfig DISPLAY_NXP_DCIF
	bool "NXP DCIF driver"
	default y
	depends on DT_HAS_NXP_DCIF_ENABLED
	select PINCTRL
	help
	  Enable support for NXP DCIF driver.


if DISPLAY_NXP_DCIF

config NXP_DCIF_FB_NUM
	int "Framebuffers to allocate in driver"
	default 1
	range 0 2
	help
	  Number of framebuffers to allocate in DCIF driver. Driver allocated
	  framebuffers are required to support partial display updates.
	  The driver has been validated to support 0 through 2 framebuffers.
	  Note that hardware will likely perform best if zero driver
	  framebuffers are allocated by the driver, and the application
	  implements double framebuffering by always calling display_write with
	  a buffer equal in size to the connected panel.


config NXP_DCIF_MAINTAIN_CACHE
	bool "Maintain cache coherency"
	default y
	help
	  Maintain cache coherency for DCIF framebuffer. This is generally
	  required, unless an external framebuffer is utilized with custom
	  caching settings, or caching is disabled.

config NXP_DCIF_QOS
	bool "Set the DCIF read QoS"
	default y
	depends on SOC_SERIES_IMXRT266X
	help
	  Program the DCIF AXI read QoS in the MEDIA MODCON. The reset value
	  is 0, the lowest priority.

if NXP_DCIF_QOS

config NXP_DCIF_ARQOS
	int "Normal read QoS"
	default 7
	range 0 15

config NXP_DCIF_PANIC_ARQOS
	int "Read QoS while in panic"
	default 15
	range 0 15

endif # NXP_DCIF_QOS

endif # DISPLAY_NXP_DCIF
